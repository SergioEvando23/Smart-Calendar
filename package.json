{
  "name": "agenda-inteligente",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\" --max-warnings=0",
    "dev:api": "npm run dev --workspace=@agenda/api",
    "dev:web": "npm run dev --workspace=@agenda/web",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" },
  "devDependencies": { "@eslint/js": "10.0.1", "eslint": "10.12.0", "globals": "17.13.0", "typescript-eslint": "8.71.2" }
}
